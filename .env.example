# Frontend API base. Leave empty on Vercel to use the same-origin /api route.
VITE_API_URL=
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_APP_PASSWORD=your-provider-app-password
SMTP_FROM=your-email@example.com
# Africa's Talking SMS (OTP delivery). Get these from https://account.africastalking.com
AT_USERNAME=your-at-username
AT_API_KEY=your-at-api-key
AT_SENDER_ID=your-registered-sender-id
# Public URL used in email confirmation links (e.g. https://your-app.vercel.app)
PUBLIC_API_URL=https://your-app.vercel.app
# Billing / payments. Test mode auto-confirms payments (for local dev).
PAYMENT_TEST_MODE=true
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-secret
# EcoCash Instant Payments gateway (https://developers.ecocash.co.zw/portal).
# Set ECOCASH_* to go live; omit them (PAYMENT_TEST_MODE=true) for auto-confirm local dev.
# ECOCASH_ENVIRONMENT=production
# ECOCASH_BASE_URL=https://developers.ecocash.co.zw/sandbox/payment/v1
# ECOCASH_PRODUCTION_BASE_URL=https://eip.ecocash.co.zw/payment/v1
# ECOCASH_API_USERNAME=your-api-username
# ECOCASH_API_PASSWORD=your-api-password
# ECOCASH_MERCHANT_CODE=your-merchant-code
# ECOCASH_MERCHANT_NUMBER=your-merchant-msisdn
# ECOCASH_MERCHANT_PIN=your-merchant-pin
# ECOCASH_NOTIFY_URL=https://your-app.vercel.app/api/payments/verify
# ECOCASH_TRAN_TYPE=MERCHANT
# ECOCASH_TRANSACTION_OPERATION_STATUS=Charged
# ECOCASH_CHANNEL=Online
# ECOCASH_PURCHASE_CATEGORY_CODE=Online Payment
