# Frontend API base. Leave empty on Vercel to use the same-origin /api route.
VITE_API_URL=
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@example.com
SMTP_APP_PASSWORD=your-provider-app-password
SMTP_FROM=your-email@example.com
# OmniFlex SMS (primary OTP delivery for phone sign-ups / sign-ins) https://omniflex.co.zw/developers
# Create a key in the OmniFlex dashboard: Settings -> Developer Keys (it starts with omf_live_).
OMNIFLEX_API_KEY=omf_live_your_key
OMNIFLEX_SENDER_ID=
OMNIFLEX_BASE_URL=https://omniflex.co.zw/api
# Africa's Talking SMS (fallback when OMNIFLEX_API_KEY is not set). Get these from https://account.africastalking.com
AT_USERNAME=your-at-username
AT_API_KEY=your-at-api-key
AT_SENDER_ID=your-registered-sender-id
# Public URL used in email confirmation links (e.g. https://your-app.vercel.app)
PUBLIC_API_URL=https://your-app.vercel.app
# Billing: shops are unlocked by super admin approval only (no online payments).
# A shop is created as "pending", the super admin approves it from the
# clickcountsuperadmin console, and it locks again after APPROVAL_DAYS (30).
